# ---------------------------------------------------------------------------
# ICT Futures Platform — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Abacus.AI API key (used for AI insight generation)
ABACUSAI_API_KEY="your-abacus-api-key"

# ---------------------------------------------------------------------------
# Email alerts (Gmail SMTP)
# GMAIL_APP_PASSWORD must be a Google "App Password" (16 chars, no spaces),
# NOT the normal account password. Generate one at:
#   https://myaccount.google.com/apppasswords
# Leave GMAIL_APP_PASSWORD blank to disable email sending (app still works).
# ---------------------------------------------------------------------------
GMAIL_USER="ictfuturestrading@gmail.com"
GMAIL_APP_PASSWORD=""
EMAIL_FROM="ICT Futures <ictfuturestrading@gmail.com>"
