generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  alerts        Alert[]
  settings      UserSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Instrument {
  id              String           @id @default(cuid())
  symbol          String           @unique
  name            String
  exchange        String           @default("CME")
  tickSize        Float            @default(0.25)
  pointValue      Float            @default(50)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  priceSnapshots  PriceSnapshot[]
  detectedPatterns DetectedPattern[]
  tradeSetups     TradeSetup[]
  alerts          Alert[]
}

model PriceSnapshot {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  timeframe    String
  timestamp    DateTime
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Float      @default(0)
  createdAt    DateTime   @default(now())

  @@unique([instrumentId, timeframe, timestamp])
  @@index([instrumentId, timeframe])
  @@index([timestamp])
}

model DetectedPattern {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  patternType  String
  direction    String
  timeframe    String
  priceLevel   Float
  upperBound   Float?
  lowerBound   Float?
  description  String?
  confidence   Float      @default(0)
  resolved     Boolean    @default(false)
  outcome      String?
  detectedAt   DateTime   @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([instrumentId, patternType])
  @@index([detectedAt])
  @@index([resolved])
}

model TradeSetup {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  direction    String
  timeframe    String
  entryPrice   Float
  stopLoss     Float
  takeProfit   Float
  riskReward   Float
  aiScore      Float      @default(0)
  confluences  String
  explanation  String?
  status       String     @default("ACTIVE")
  outcome      String?
  pnl          Float?
  detectedAt   DateTime   @default(now())
  closedAt     DateTime?
  createdAt    DateTime   @default(now())

  @@index([instrumentId])
  @@index([status])
  @@index([aiScore])
}

model Alert {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId String?
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  type         String
  title        String
  message      String
  aiScore      Float?
  status       String      @default("ACTIVE")
  read         Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([userId, status])
  @@index([createdAt])
}

model PatternOutcome {
  id              String   @id @default(cuid())
  patternType     String
  direction       String
  instrumentSymbol String
  timeframe       String
  confluences     String?
  entryPrice      Float
  exitPrice       Float?
  outcome         String
  pnlPercent      Float?
  createdAt       DateTime @default(now())

  @@index([patternType, outcome])
  @@index([instrumentSymbol])
}

model UserSettings {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshInterval  Int     @default(60)
  theme            String  @default("dark")
  trackedSymbols   String  @default("ES=F,NQ=F,CL=F,GC=F")
  alertMinScore    Float   @default(60)
  alertOnOB        Boolean @default(true)
  alertOnFVG       Boolean @default(true)
  alertOnLiqSweep  Boolean @default(true)
  alertOnMSS       Boolean @default(true)
  alertOnOTE       Boolean @default(true)
  notificationsOn  Boolean @default(true)
}
