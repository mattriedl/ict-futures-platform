generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // "USER" | "ADMIN"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  alerts        Alert[]
  settings      UserSettings?
  demoAccount   DemoAccount?
  demoTrades    DemoTrade[]
  backtests     BacktestRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Instrument {
  id              String           @id @default(cuid())
  symbol          String           @unique
  name            String
  exchange        String           @default("CME")
  tickSize        Float            @default(0.25)
  pointValue      Float            @default(50)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  priceSnapshots  PriceSnapshot[]
  detectedPatterns DetectedPattern[]
  tradeSetups     TradeSetup[]
  alerts          Alert[]
  demoTrades      DemoTrade[]
}

model PriceSnapshot {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  timeframe    String
  timestamp    DateTime
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Float      @default(0)
  createdAt    DateTime   @default(now())

  @@unique([instrumentId, timeframe, timestamp])
  @@index([instrumentId, timeframe])
  @@index([timestamp])
}

model DetectedPattern {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  patternType  String
  direction    String
  timeframe    String
  priceLevel   Float
  upperBound   Float?
  lowerBound   Float?
  description  String?
  confidence   Float      @default(0)
  resolved     Boolean    @default(false)
  outcome      String?
  detectedAt   DateTime   @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([instrumentId, patternType])
  @@index([detectedAt])
  @@index([resolved])
}

model TradeSetup {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  direction    String
  timeframe    String
  entryPrice   Float
  stopLoss     Float
  takeProfit   Float
  riskReward   Float
  aiScore      Float      @default(0)
  confluences  String
  explanation  String?
  status       String     @default("ACTIVE")
  outcome      String?
  pnl          Float?
  detectedAt   DateTime   @default(now())
  closedAt     DateTime?
  createdAt    DateTime   @default(now())

  @@index([instrumentId])
  @@index([status])
  @@index([aiScore])
}

model Alert {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId String?
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  type         String
  title        String
  message      String
  aiScore      Float?
  status       String      @default("ACTIVE")
  read         Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([userId, status])
  @@index([createdAt])
}

model PatternOutcome {
  id              String   @id @default(cuid())
  patternType     String
  direction       String
  instrumentSymbol String
  timeframe       String
  confluences     String?
  entryPrice      Float
  exitPrice       Float?
  outcome         String
  pnlPercent      Float?
  createdAt       DateTime @default(now())

  @@index([patternType, outcome])
  @@index([instrumentSymbol])
}

model UserSettings {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshInterval  Int     @default(60)
  theme            String  @default("dark")
  trackedSymbols   String  @default("ES=F,NQ=F,CL=F,GC=F")
  alertMinScore    Float   @default(60)
  alertOnOB        Boolean @default(true)
  alertOnFVG       Boolean @default(true)
  alertOnLiqSweep  Boolean @default(true)
  alertOnMSS       Boolean @default(true)
  alertOnOTE       Boolean @default(true)
  notificationsOn  Boolean @default(true)
  emailAlertsEnabled Boolean @default(false)
  alertEmail       String?
  // Risk-based position sizing & prop-firm drawdown guard
  riskPercent                Float   @default(1) // % of balance risked per trade
  maxDailyLossPercent        Float   @default(4) // daily loss limit (% of day-start balance)
  maxOverallDrawdownPercent  Float   @default(6) // overall drawdown limit (% of peak)
  enforceDrawdown            Boolean @default(false) // hard-block new trades when a limit is breached
  // Per-asset-class leverage for demo margin/notional handling
  leverageCrypto             Float   @default(1)  // crypto: full notional must fit (no leverage)
  leverageForex              Float   @default(30) // FX
  leverageFutures            Float   @default(10) // futures
  // Automated trading (autotrader)
  autoTradeEnabled           Boolean @default(false) // scan & place on-hold auto-trades on schedule
  autoTradeMinScore          Float   @default(75)     // min setup score to auto-place a pending trade
}

// ---------------------------------------------------------------------------
// Demo / paper-trading, backtesting, and admin models
// ---------------------------------------------------------------------------

model DemoAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String   @default("Demo Account")
  startingBalance Float    @default(100000)
  currentBalance  Float    @default(100000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DemoTrade {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId  String?
  instrument    Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  symbol        String
  direction     String     // "LONG" | "SHORT"
  source        String     @default("MANUAL") // "ONE_CLICK" | "MANUAL"
  entryPrice    Float
  stopLoss      Float
  takeProfit    Float
  positionSize  Float      @default(1)
  pointValue    Float?     // USD value of a 1.00 move per contract, fixed at entry (FX converted to USD); null on older trades
  margin        Float?     // dollar margin reserved while OPEN; null/0 once closed
  pendingApproach String?  // for PENDING auto-trades: 'RISE' | 'FALL' — direction price must move to reach entry
  expiresAt     DateTime?  // for PENDING auto-trades: auto-cancel time if entry never reached
  riskReward    Float      @default(0)
  aiScore       Float?
  confluences   String?    // JSON string
  timeframe     String     @default("15m")
  status        String     @default("OPEN") // "OPEN" | "WIN" | "LOSS" | "CLOSED_MANUAL"
  outcome       String?
  exitPrice     Float?
  pnl           Float?
  pnlPercent    Float?
  rMultiple     Float?
  dataSource    String?    // provenance of resolving bars, e.g. "REAL:yahoo" / "REAL:crypto"
  notes         String?
  tradeSetupId  String?
  openedAt      DateTime   @default(now())
  closedAt      DateTime?
  createdAt     DateTime   @default(now())

  @@index([userId, status])
  @@index([symbol])
  @@index([openedAt])
}

// Learning / history store: every detected setup logged at analyze time, later
// linked to its realized demo-trade outcome so we can compute empirical hit-rates
// and weight the AI score. userId is nullable (analyze can be unauthenticated).
model SetupLog {
  id           String    @id @default(cuid())
  userId       String?
  symbol       String
  assetClass   String    // "futures" | "forex" | "crypto"
  timeframe    String
  bias         String    // "BULLISH" | "BEARISH" | "NEUTRAL"
  direction    String    // "LONG" | "SHORT"
  aiScore      Float
  confluences  String    // JSON string array of confluence tags
  entryPrice   Float?
  stopLoss     Float?
  takeProfit   Float?
  detectedAt   DateTime  @default(now())
  // Outcome linkage (filled when a matching demo trade resolves).
  demoTradeId  String?
  outcome      String?   // "WIN" | "LOSS" | null
  rMultiple    Float?
  resolvedAt   DateTime?

  @@index([assetClass, timeframe])
  @@index([outcome])
  @@index([userId, symbol, direction])
  @@index([detectedAt])
}

model BacktestRun {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol             String
  timeframe          String
  startDate          DateTime
  endDate            DateTime
  requiredConfluences String  @default("[]") // JSON array of pattern types
  minAiScore         Float    @default(0)
  riskPerTrade       Float    @default(1)
  config             String?  // JSON of full config
  totalTrades        Int      @default(0)
  wins               Int      @default(0)
  losses             Int      @default(0)
  winRate            Float    @default(0)
  avgRR              Float    @default(0)
  profitFactor       Float    @default(0)
  netR               Float    @default(0)
  netPnlPercent      Float    @default(0)
  maxDrawdownPercent Float    @default(0)
  equityCurve        String   @default("[]") // JSON array of {t, equity}
  trades             String   @default("[]") // JSON array of simulated trades
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

model AppSettings {
  id                      String   @id @default("global")
  defaultStartingBalance  Float    @default(100000)
  registrationOpen        Boolean  @default(true)
  backtestingEnabled      Boolean  @default(true)
  oneClickTradingEnabled  Boolean  @default(true)
  emailAlertsEnabled      Boolean  @default(true)
  siteName                String   @default("ICT Futures")
  updatedAt               DateTime @updatedAt
}
