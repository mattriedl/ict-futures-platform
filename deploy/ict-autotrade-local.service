[Unit]
Description=ICT Futures scheduled cycle (autotrader + alerts) via local endpoint
After=network-online.target ict-futures.service
Wants=network-online.target

[Service]
Type=oneshot
# Edit to match the install: the user that owns the app, and its directory.
User=__RUN_USER__
Environment=APP_DIR=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/deploy/ict-autotrade-local.sh
