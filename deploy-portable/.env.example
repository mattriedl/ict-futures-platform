# =============================================================================
# ICT Futures Trading Platform — environment template
# Copy to ".env" in the project root and fill in real values.
# DO NOT commit a filled-in .env — it is gitignored.
# =============================================================================

# ----------------------------------------------------------------------------
# Database (required)
# ----------------------------------------------------------------------------
# For Docker Compose the app talks to the bundled "db" service. The POSTGRES_*
# vars below configure that container AND compose builds DATABASE_URL from them.
# If you use an EXTERNAL/managed Postgres, set DATABASE_URL directly and ignore
# the POSTGRES_* vars.
POSTGRES_USER=ict
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=ict_futures

# Full connection string used by Prisma / the app.
# Docker Compose default (points at the bundled db service):
#   postgresql://ict:change_me_db_password@db:5432/ict_futures?schema=public
# Bare-metal / VPS example (local Postgres):
#   postgresql://ict:change_me_db_password@localhost:5432/ict_futures?schema=public
DATABASE_URL=postgresql://ict:change_me_db_password@db:5432/ict_futures?schema=public

# ----------------------------------------------------------------------------
# NextAuth (required)
# ----------------------------------------------------------------------------
# Public base URL of the deployed app (used for auth callbacks & absolute links).
NEXTAUTH_URL=http://localhost:3456
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=change_me_generate_a_32char_secret

# ----------------------------------------------------------------------------
# AI trade explanations (optional)
# ----------------------------------------------------------------------------
# OpenAI-compatible chat-completions endpoint. The app POSTs to
# "${LLM_BASE_URL}/chat/completions". Leave LLM_BASE_URL / LLM_API_KEY blank to
# disable the "Explain" feature (the endpoint returns 503 gracefully).
#   OpenAI:      https://api.openai.com/v1
#   Abacus.AI:   https://apps.abacus.ai/v1
LLM_BASE_URL=
LLM_API_KEY=
# Model name understood by the endpoint above (e.g. gpt-4o, claude-opus-4-5).
LLM_MODEL=gpt-4o

# ----------------------------------------------------------------------------
# Email (optional — password reset / notifications via Gmail SMTP)
# ----------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# ----------------------------------------------------------------------------
# Deployment / runtime
# ----------------------------------------------------------------------------
# Host port to expose the app on (container always listens on 3456 internally).
APP_PORT=3456
# Seed the 37 instruments (15 futures + 22 crypto) on container start.
RUN_SEED=true
# The app's Next.js dist dir. MUST stay ".build" (next.config.js reads this).
NEXT_DIST_DIR=.build

# ----------------------------------------------------------------------------
# Abacus.AI-specific (optional — leave BLANK for self-hosting)
# ----------------------------------------------------------------------------
# Injects a client-side script tag. Only relevant on the Abacus platform.
# Leave unset for a normal self-hosted deployment.
NEXT_PUBLIC_APPLLM_LIB_URL=
